{
  "name": "cortico-world-reminder",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico World: local reminders that wake the conversation when they come due",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "reminder"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "tags": [
      "companion"
    ],
    "describe": "describe.json",
    "displayName": "提醒",
    "icon": "icon.svg",
    "locales": {
      "zh": {
        "displayName": "提醒",
        "description": "到点自己开口叫你:提前预告、重复提醒都能配,关机错过的下次开机补上。"
      },
      "en": {
        "displayName": "Reminder",
        "description": "Speaks up when a reminder comes due: lead time, repeats, and a catch-up pass for what was missed while the bot was off."
      }
    }
  },
  "files": [
    "src",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
