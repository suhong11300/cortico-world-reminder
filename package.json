{
  "name": "cortico-world-reminder",
  "version": "0.1.1",
  "type": "module",
  "description": "在对话中按设定时间提醒事项。支持重复提醒、提前预告与延后；离线期间错过的提醒在下次启动时补发。",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "reminder"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "tags": [
      "companion"
    ],
    "describe": "describe.json",
    "displayName": "提醒",
    "icon": "icon.svg",
    "locales": {
      "zh": {
        "displayName": "提醒",
        "description": "在对话中按设定时间提醒事项。支持重复提醒、提前预告与延后；离线期间错过的提醒在下次启动时补发。"
      },
      "en": {
        "displayName": "Reminder",
        "description": "Reminds you in conversation at the times you set. Supports repeats, early notice and snooze; reminders missed while offline are delivered on the next start."
      }
    }
  },
  "files": [
    "src",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
